# Both apps/*/Dockerfile build from the repository root, so this is the one
# .dockerignore that matters (a nested apps/*/.dockerignore is never
# consulted for a `docker build -f apps/*/Dockerfile .` build with that
# context). Keep it broad: bloating the build context slows every build,
# COPY included below or not.
node_modules
**/node_modules
**/.next
**/.medusa
**/dist
**/build
**/coverage
.git
.gitignore
.turbo
**/*.log

# Worktrees and workflow scaffolding never belong in an image
.ai
artifacts
deploy/stands/*.env
!deploy/stands/*.env.example

# Local env files carry real secrets; the images take config through
# --build-arg (storefront) and the compose env file (backend), never a
# baked-in .env
**/.env
**/.env.local
!**/.env.template
!**/.env.example

# Store-profile media bytes are gitignored and synced separately by
# deploy/scripts/sync-media.sh onto a host volume, never baked into either
# image
apps/backend/src/migration-scripts/data/profiles/*/media/*.webp
apps/backend/src/migration-scripts/data/profiles/*/media/*.png
apps/backend/src/migration-scripts/data/profiles/*/media/*.jpg
