{
  "name": "gorgo-medusa-dtc-starter-monorepo",
  "private": false,
  "description": "Medusa DTC Starter by Gorgo: a Medusa backend and a Next.js storefront for direct-to-consumer commerce. Production-ready.",
  "author": "Gorgo (https://gorgojs.com)",
  "license": "MIT",
  "homepage": "https://docs.gorgojs.com/tools/medusa-dtc-starter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gorgojs/medusa-dtc-starter.git"
  },
  "bugs": "https://github.com/gorgojs/medusa-dtc-starter/issues",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": "^10.11.1"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:methods": "node --test tools/test-methods/__tests__/ && node tools/test-methods/tm.mjs verify all && node tools/test-methods/tm.mjs run all",
    "check:locale-catalogs": "node scripts/check-locale-catalogs.mjs",
    "backend:seed": "turbo seed --filter=@dtc/gorgo-medusa-backend",
    "check:backend-build": "cd apps/backend && npx medusa build --lint false",
    "check:backend-fixtures": "cd apps/backend && npx tsc -p scripts/fixtures/tsconfig.json",
    "check:shared-markdown": "node scripts/check-shared-markdown.mjs",
    "check:evidence": "node scripts/check-evidence-manifest.mjs",
    "backend:dev": "turbo dev --filter=@dtc/gorgo-medusa-backend",
    "storefront:dev": "turbo dev --filter=@dtc/gorgo-medusa-storefront"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "sharp": ">=0.35.4",
      "lodash": ">=4.18.1"
    }
  },
  "devDependencies": {
    "turbo": "^2.0.14",
    "prettier": "^3.2.5"
  }
}
