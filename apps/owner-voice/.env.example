# Owner voice chat stand. Copy to .env next to docker-compose.yml and fill in.
# Every key is optional: a part with no key runs on recorded fixtures and the
# page header says «записи» for it. Never commit .env.

# Port inside the container (compose maps OWNER_VOICE_PORT on the host to it).
PORT=5470

# The shop. Defaults point at cherkashino.com on the INTL engine.
SHOP_API_URL=https://shipshift.dev
SHOP_HOST=cherkashino.com
SHOP_PANEL_URL=https://panel.cherkashino.com
SHOP_STOREFRONT_URL=https://cherkashino.com
SHOP_LOCALE=ru
SHOP_COUNTRY=ru

# Orders, sales, stock and reviews: a shop panel login (role «manager» is
# enough and cannot touch settings or staff). Without it these four run on fixtures.
SHOP_LOGIN_EMAIL=
SHOP_LOGIN_PASSWORD=
# HTTP Basic password for the page. Required once the shop login, ELEVENLABS_API_KEY
# or ANTHROPIC_API_KEY is set: the page shows the shop's sales and the keys spend
# paid credits. Without it such a stand refuses to start.
STAND_PASSWORD=

# Speech in and out. Without the key, speech runs on fixtures.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_STT_MODEL_ID=scribe_v1
# 1 lets the voice settings add a library voice to the account (a write to it). Off by default.
ELEVENLABS_ALLOW_ADD_VOICE=0

# The model. Without the key the keyword router answers instead.
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# 1 = the Store API on fixtures too, for a run with no network.
SHOP_FIXTURES=

# Stage 3: writes. Off by default: a confirm shows the request and sends nothing.
# 1 = a confirmed proposal becomes a changeset on stage (/tenants/agent-changesets*
# only); «публикуй» puts it on the main site, «откати» takes it back.
CHANGESETS=0
# The stage site for the links on a card. Default stage.<SHOP_HOST>.
STAGE_HOST=

# intl (default) or ru. ru turns Claude and images off whatever the keys.
SHOP_REGION=intl

# The model's daily cap in USD, counted per UTC day on the server. Past it the
# keyword router answers and the page says why. Prices per million tokens.
MODEL_DAILY_USD=5
MODEL_USD_PER_MTOK_IN=3
MODEL_USD_PER_MTOK_OUT=15

# Images: 0 turns them off. The provider is a stub until a real one is chosen.
IMAGES=1
IMAGE_DAILY_USD=3
IMAGE_DAILY_COUNT=30
IMAGE_STUB_USD=0.04

# Where the stand keeps its daily counts, uploads and image previews (compose: /data).
DATA_DIR=/data
# The stand's own origin: a picture put on the site is linked from here.
PUBLIC_URL=
# Uploads, transcripts and unplaced previews are deleted after this many hours.
FILES_TTL_HOURS=24
