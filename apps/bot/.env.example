# Боевой стенд читает эти переменные из /opt/upready-store-bot/.env через
# env_file docker-compose.yml. Команды деплоя и отката — DEPLOY.md рядом.

# Токен бота @upreadystore_bot. Боевое значение лежит в .env рядом с этим
# файлом; .env в git не уезжает (**/.env в корневом .gitignore) и в отчётах
# не цитируется.
TELEGRAM_UPREADY_STORE_BOT=

# Платёжные адреса Tribute: один на тариф на способ оплаты.
# Номер — это номер карточки на странице тарифов, он же цифра диплинка
# `?start=plan_<n>`: 1 — Новичок, 2 — Профи, 3 — Мастер.
#
# Незаданная переменная — это ОТСУТСТВИЕ ссылки, а не рабочая кнопка: бот
# такую кнопку не рисует вовсе и говорит, что оплату подключают (правило 20a).
# Значение должно быть http(s)-адресом; мусор трактуется так же, как пустота,
# но пишется в лог как `gap: invalid`.
TRIBUTE_URL_PLAN_1_RU_MIR=
TRIBUTE_URL_PLAN_1_VISA_MC=
TRIBUTE_URL_PLAN_2_RU_MIR=
TRIBUTE_URL_PLAN_2_VISA_MC=
TRIBUTE_URL_PLAN_3_RU_MIR=
TRIBUTE_URL_PLAN_3_VISA_MC=

# База Bot API. Пусто — https://api.telegram.org. Переопределяется, когда
# исходящие сообщения нужно снять локальным приёмником, не трогая код.
TELEGRAM_API_BASE=

# --- привязка магазина к чату (t08-order-notifications) -----------------
# Владелец магазина жмёт в панели `https://t.me/upreadystore_bot?start=lk_…`,
# бот отдаёт код бэкенду, бэкенд запоминает чат за магазином.
#
# Адрес бэкенда. На живом хосте бот и MT-стек стоят в РАЗНЫХ compose-проектах,
# поэтому внутреннего имени `mt-backend` у бота нет — сюда пишется публичный
# адрес движка (https://shipshift.dev) либо адрес стенда.
UPREADY_BACKEND_URL=
# Общий секрет с бэкендом: ровно то же значение, что в TELEGRAM_LINK_SECRET
# у mt-backend. Пустой с любой стороны — привязка не работает, и бот говорит
# об этом владельцу вместо молчания.
TELEGRAM_LINK_SECRET=
