/dist
.env
# Backups scripts/stand-use-live-copy.mjs writes before it switches .env; they carry the same secrets.
.env.bak-*
.DS_Store
/uploads
/node_modules
yarn-error.log

.idea

coverage

!src/**

./tsconfig.tsbuildinfo
medusa-db.sql
build
.cache

.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

.medusa
**/.DS_Store

# Store profiles (t-store-profiles-pilot): generated media bytes never enter git.
# Must sit AFTER `!src/**` above, which would otherwise re-include them
# (measured with `git check-ignore -v`). media/manifest.json stays tracked.
src/migration-scripts/data/profiles/*/media/*.webp
src/migration-scripts/data/profiles/*/media/*.png
src/migration-scripts/data/profiles/*/media/*.jpg
static/
