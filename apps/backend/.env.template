STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
# Development runs the cache, event bus, and workflow engine in memory.
# Uncomment to use REDIS_URL in development too. Production always uses it.
# USE_REDIS=true
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DB_NAME=medusa_dtc_starter
DATABASE_URL=postgres://postgres@localhost/$DB_NAME
MEDUSA_ADMIN_ONBOARDING_NEXTJS_DIRECTORY=medusa-storefront

# Medusa Integration Module (see https://gorgojs.com/medusa-integration-module)
INTEGRATION_ENCRYPTION_KEY=supersecret

# Set to "off" to stop the marketplace sync job (apps/backend/src/jobs/marketplace-sync.ts)
# from calling Wildberries or Ozon on its own five-minute schedule. Data then comes only from
# «Обновить сейчас» (POST /tenants/marketplaces/sync). Leave unset in production.
# MP_SCHEDULER=off
# Public address of the backend, for the Robokassa Result URL shown in the panel
# (`<BACKEND_PUBLIC_URL>/robokassa/result`). Set it on every deployment.
BACKEND_PUBLIC_URL=

# SMTP configuration for transactional emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=

# Storefront URL (used in email links)
STOREFRONT_URL=http://localhost:8000

# The platform's /pricing page, for the preview link on the admin's «Тарифы» page (optional)
PLATFORM_PRICING_URL=

# Shared secret sent as x-revalidate-secret to the storefront's /api/revalidate endpoint
# (must match REVALIDATE_SECRET in apps/storefront/.env.local)
REVALIDATE_SECRET=supersecret

# Shared secret the storefront's hidden settings panel sends as
# x-storefront-settings-secret when it writes the site-wide block composition and
# default mode (PUT /store/storefront-settings). Same shape as REVALIDATE_SECRET above
# (must match STOREFRONT_SETTINGS_SECRET in apps/storefront/.env.local) — reading the
# setting has no secret, since it goes out to every visitor on every page.
STOREFRONT_SETTINGS_SECRET=supersecret

# Fallback locale for emails when the order/customer carries none.
# Must be one of the locales in apps/backend/src/emails/i18n/messages (falls back to en).
STOREFRONT_DEFAULT_LOCALE=en
# Where /static/store-profiles is served from, the parent of every starter dataset's
# media directory. The onboarding wizard's starter catalog (POST /tenants/seed) and
# seed-mt-demo build every image URL from it and refuse to write a relative one, so
# without this variable both answer 500 («Neither STORE_PROFILES_MEDIA_BASE_URL nor
# STORE_MEDIA_BASE_URL is set»). On a stand that is this backend's own address.
STORE_PROFILES_MEDIA_BASE_URL=http://localhost:9000/static/store-profiles

# Store branding used in email templates. These are the values the code falls
# back to when the variable is unset, repeated here so they are easy to change.
# STORE_NAME is also the sender name every email arrives under, so the inbox
# reads "Gorgo Medusa Store" instead of the bare SMTP_FROM address.
STORE_NAME="Gorgo Medusa Store"
STORE_EMAIL=hello@example.com

# Printed verbatim in the footer of every email, and left out of it when empty.
# Fill them in before going live rather than shipping a placeholder address to
# real customers. Many jurisdictions require a postal address in commercial mail.
# STORE_PHONE=+49 30 901820
# STORE_ADDRESS=Beispielstrasse 1, 10115 Berlin, Germany
STORE_PHONE=
STORE_ADDRESS=

# ---------------------------------------------------------------------------
# Sign in with Yandex ID (storefront buyers). Optional, the same shape as Redis
# and SMTP above: leave YANDEX_CLIENT_ID empty and the provider is never
# registered, so the backend boots and behaves exactly as it did before.
#
# Set them and /auth/customer/yandex appears. A HALF-filled block fails at boot
# rather than at a buyer's consent screen. Credentials come from
# https://oauth.yandex.ru/client/new/id/ — the application needs the login:email
# and login:info permissions, and one Redirect URI per storefront host, spelled
# character for character (docs/auth-yandex.md).
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# The Redirect URI of the single-store install, and the default for a request
# that names none. Always <storefront origin>/api/yandex-callback.
YANDEX_CALLBACK_URL=http://localhost:8000/api/yandex-callback

# Comma-separated extra origins a storefront may name as its own callback, for a
# multi-tenant deployment where every shop has its own domain. Yandex refuses
# any Redirect URI its application has not registered, so this is defence in
# depth rather than the gate itself.
# YANDEX_CALLBACK_ORIGINS=https://cherkashino.ru,https://xn--80ajkgrgj8cn.xn--p1ai
YANDEX_CALLBACK_ORIGINS=

# Narrow the permissions asked for on the consent screen. Leave empty to use the
# ones the application itself was granted — asking for a permission it does not
# hold makes Yandex reject the request.
YANDEX_SCOPE=

# The hosts a school may receive a buyer's sign-in code on, comma separated
# (t-2026-10-08-36, `POST /store/tenant/sso/code`). Leave it empty and the shop
# mints no code. Give the storefront the same list.
# SCHOOL_SSO_RETURN_HOSTS=school.cherkashina.ru
SCHOOL_SSO_RETURN_HOSTS=

# Show the Yandex account picker even when a session is already open, so a
# shared browser does not silently reuse the previous account.
YANDEX_FORCE_CONFIRM=false

# ---------------------------------------------------------------------------
# The platform's own login. Set it and every shop a tenant creates gets a
# tenant_admin row for this email (the auth identity is shared across every
# shop, never re-registered); leave it unset and the feature is off, no shop
# gets the row. Backfilling every EXISTING shop is a separate, explicit step:
# npx medusa exec ./scripts/fixtures/o25-platform-admin-all-shops.ts
# PLATFORM_ADMIN_EMAIL=app@root.dev
PLATFORM_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Telegram Bot API base URL for the store's Mini App provisioning (POST /admin/telegram-mini-app).
# Leave unset for api.telegram.org; point it at a mock server to exercise the flow without a bot token.
# TELEGRAM_API_BASE_URL=https://api.telegram.org

# ---------------------------------------------------------------------------
# Medusa's own multi-language feature flag (default off). It is what makes the
# Store API and the cart apply the Translation module's rows by entity id
# (`@medusajs/utils` `applyTranslations`, gated on this exact flag) — the panel's
# «Переводы» screen and `scripts/product-translations.ts` write translations
# either way, but a visitor sees them only once this is on.
#
# PR #218 review: this is a `FeatureFlag` singleton registered once per
# backend process at boot (`@medusajs/framework`'s `featureFlagsLoader`) —
# core has no per-tenant scope for it, so it is instance-wide by construction,
# not a product choice we could narrow to cherkashino.com alone. It is safe
# globally because `applyTranslations` matches rows by `reference_id` +
# `locale_code` only, with no tenant filter, and leaves any field untouched
# when no row matches: a tenant with zero translation rows sees byte-identical
# output whether this flag is on or off. See
# `src/migration-scripts/lib/__tests__/apply-translations-global-flag.unit.spec.ts`.
MEDUSA_FF_TRANSLATION=true
