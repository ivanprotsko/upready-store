{
  "name": "@dtc/gorgo-medusa-school",
  "version": "0.1.0",
  "private": true,
  "description": "School cabinet: a buyer's courses on their own host, rendered on the server by React Router and read from the shop's Store API.",
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "react-router dev --port 5190",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "isbot": "^5.1.31",
    "react": "19.0.5",
    "react-dom": "19.0.5",
    "react-router": "7.18.2"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.2",
    "@types/node": "^20.19.0",
    "@types/react": "19.0.5",
    "@types/react-dom": "19.0.5",
    "@typescript-eslint/parser": "8.49.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "4.1.11"
