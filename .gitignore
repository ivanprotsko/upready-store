.Trashes
ehthumbs.db
Thumbs.db
**/.DS_Store
tsconfig.tsbuildinfo

# Claude Code local settings (per-developer, never committed)
.claude/settings.local.json

# Store profiles (t-store-profiles-pilot): generated media never enters git.
# Manifests and catalog JSON DO stay in git; only the bytes are ignored.
apps/backend/static/
apps/backend/src/migration-scripts/data/profiles/*/media/*.webp
apps/backend/src/migration-scripts/data/profiles/*/media/*.png
apps/backend/src/migration-scripts/data/profiles/*/media/*.jpg
artifacts/media/*
# Re-enter the profile dirs, then re-ignore everything one level deeper, so raw
# renders and contact sheets stay out of history (rule 21f: no binaries in git).
!artifacts/media/*/
artifacts/media/*/*
# ...except the second-pass list, which is a DOCUMENT: it is the only record of
# which paid frames still owe a re-render. Losing it would lose the decision.
!artifacts/media/*/second-pass.json

# Contact sheet screenshots (t-store-profiles-pilot): binaries never enter git.
# shoot.log and manifest.json (siblings, not under shots/) stay tracked as documents.
artifacts/docs/contact-sheet/shots/

# Stand index screenshots (t-store-profiles-pilot): binaries never enter git.
# build.mjs, shot.mjs, tokens.css and index.html stay tracked as documents.
artifacts/docs/stands/shot-*.png
artifacts/docs/hero-lab/shot-*.png
artifacts/docs/hero-lab-2/shot-*.png
artifacts/docs/hero-lab-2/collection/*.webp
artifacts/docs/blocks-lab/shot-*.png
artifacts/docs/blocks-lab/sheets/*.webp
# Third-party storefront screenshots kept for reference only — never re-hosted.
artifacts/docs/hero-lab/refs/
# Tall source frames for the upready.dev showcase — regenerated by landing-shots/shoot.mjs.
artifacts/docs/landing-shots/*.png
artifacts/docs/stands/devtools-*.png
# Composer frames: regenerated by composer/shoot.mjs from versions.json; the registry itself stays tracked.
artifacts/docs/composer/shots/

# Frames shot on the live stands by tests/stands/frames.pw.ts (t-2026-09-09-02): PNG, regenerable, never in history (rule 21f)
artifacts/stands-frames/
# Tenant panel vs Admin acceptance screenshots (t-2026-09-11-mt-tenant-panel): binaries never enter git.
artifacts/docs/tenant-panel-shots/*.png

# Real deploy env files carry generated secrets; only the *.env.example templates are tracked.
deploy/stands/*.env
deploy/mt/*.env
