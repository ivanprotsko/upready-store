# Claude Code local settings (per-developer, never committed)
.claude/settings.local.json

# Store profiles (t-store-profiles-pilot): generated media never enters git.
# Manifests and catalog JSON DO stay in git; only the bytes are ignored.
apps/backend/static/
apps/backend/src/migration-scripts/data/profiles/*/media/*.webp
apps/backend/src/migration-scripts/data/profiles/*/media/*.png
apps/backend/src/migration-scripts/data/profiles/*/media/*.jpg
artifacts/media/*
# Re-enter the profile dirs, then re-ignore everything one level deeper, so raw
# renders and contact sheets stay out of history (rule 21f: no binaries in git).
!artifacts/media/*/
artifacts/media/*/*
# ...except the second-pass list, which is a DOCUMENT: it is the only record of
# which paid frames still owe a re-render. Losing it would lose the decision.
!artifacts/media/*/second-pass.json

# Contact sheet screenshots (t-store-profiles-pilot): binaries never enter git.
# shoot.log and manifest.json (siblings, not under shots/) stay tracked as documents.
artifacts/docs/contact-sheet/shots/
artifacts/docs/f06-shipping-method-names/shots/
artifacts/docs/f10-price-save-silently-lost/shots/
artifacts/docs/w12-marketplace-core/shots/
# Playwright session state of the shop owner (cookies): never in git.
artifacts/docs/f10-price-save-silently-lost/.state-*.json

# Stand index screenshots (t-store-profiles-pilot): binaries never enter git.
# build.mjs, shot.mjs, tokens.css and index.html stay tracked as documents.
artifacts/docs/stands/shot-*.png
# b17: reference/before/after screenshots of the product page, kept on disk
# for the PR body and named there by absolute path (rule 21f: no binaries in history)
artifacts/docs/b17-pdp-gallery-info-layout/design/*.png
artifacts/docs/hero-lab/shot-*.png
artifacts/docs/hero-lab-2/shot-*.png
artifacts/docs/hero-lab-2/collection/*.webp
artifacts/docs/blocks-lab/shot-*.png
artifacts/docs/blocks-lab/sheets/*.webp
# Third-party storefront screenshots kept for reference only — never re-hosted.
artifacts/docs/hero-lab/refs/
# Tall source frames for the upready.dev showcase — regenerated by landing-shots/shoot.mjs.
artifacts/docs/landing-shots/*.png
artifacts/docs/stands/devtools-*.png
# Composer frames: regenerated by composer/shoot.mjs from versions.json; the registry itself stays tracked.
artifacts/docs/composer/shots/

# Frames shot on the live stands by tests/stands/frames.pw.ts (t-2026-09-09-02): PNG, regenerable, never in history (rule 21f)
artifacts/stands-frames/

# Acceptance screenshots, wave 2 of the MT deploy (2026-09-12): binaries never enter git.
# README.md and the probes (funnel/shot/login/storefront/isolation .mjs) stay tracked as documents.
artifacts/docs/2026-09-12-mt-deploy-acceptance/shots-w2/

# Acceptance screenshots, wave 4 (2026-09-12): binaries never enter git (21f);
# the probe scripts next to them stay tracked as tools.
artifacts/docs/2026-09-12-mt-deploy-acceptance/shots-w4/*.png
artifacts/docs/2026-09-12-mt-deploy-acceptance/shots-w5/*.png
artifacts/docs/2026-09-12-mt-deploy-acceptance/shots-w6/*.png
artifacts/docs/2026-09-12-mt-deploy-acceptance/shots-w7/*.png
# Tenant panel vs Admin acceptance screenshots (t-2026-09-11-mt-tenant-panel): binaries never enter git.
artifacts/docs/tenant-panel-shots/*.png

# Real deploy env files carry generated secrets; only the *.env.example templates are tracked.
deploy/stands/*.env
deploy/mt/*.env

# Pre-deploy probe frames of fix/mt-storefront-head-footer (2026-09-12): binaries never enter git.
# README.md and probe-local.mjs stay tracked as documents.
artifacts/docs/2026-09-12-mt-storefront-head-footer/shots/
artifacts/mockups/*/shot-*.png
artifacts/docs/f01-thankyou-brand/*.png

# w01-wb-readonly-client: full-page screenshots of the WB doc portal (4-12 MB each).
# The extracted TEXT of those pages is committed next to them and is what the
# endpoint registry cites; the PNGs stay on disk and are listed in the PR body.
artifacts/docs/w01-wb-readonly-client/docs/*.png

# b18-blog-full: скриншоты приёмки журнала — бинарники в историю не кладём (правило 21f)
artifacts/docs/b18-blog-full/**/*.png

# d09: кадры приёмки панели — бинарники вне git.
artifacts/docs/d09-deploy-integrations/shots/

# p02-operator-v1: рабочие данные оператора. Индекс корпуса, документы ответов, входящие промпты и
# журнал эскалаций — состояние РАБОТЫ, не исходник: база пересобирается `node intake/index.mjs` за
# 11 с, а в ответах и промптах стоит дословный текст Ивана. Кадры приёмки — бинарники (правило 21f).
handoff/day-2026-09-16-oksana-store/intake/operator.db
handoff/day-2026-09-16-oksana-store/intake/operator.db-wal
handoff/day-2026-09-16-oksana-store/intake/operator.db-shm
handoff/day-2026-09-16-oksana-store/intake/answers/
handoff/day-2026-09-16-oksana-store/intake/prompts/
handoff/day-2026-09-16-oksana-store/intake/escalations.log
handoff/day-2026-09-16-oksana-store/intake/inbox.json
artifacts/docs/p02-operator-v1/shots/
handoff/day-2026-09-16-oksana-store/logs/launchd-operator.log
