# Template for the env file deploy/backup/install.sh's --env-file points
# at. Copy it on the HOST (not in this repository — it is gitignored, see
# deploy/.gitignore), fill in the blanks for that host's stack, chmod 600 it
# (nothing here is secret today — the role and database name are not
# secrets, and docker exec runs as the container's own context — but a
# future value here might be), then:
#
#   deploy/backup/install.sh --project-dir /opt/upready-store/mt \
#     --env-file /opt/upready-store/mt/deploy/backup/mt.env --with-cross-copy
#
# See RUNBOOK.md for the concrete mt-stack values and the full install walk-
# through, and each script's own header comment for what every variable
# below means.

# --- nightly-run.sh / pg-backup.sh / media-backup.sh ---
BACKUP_TARGET_DIR=/opt/upready-store/backups/mt

# Pick ONE of these two DB connection modes (see pg-backup.sh):
PG_DUMP_DOCKER_CONTAINER=mt-postgres
PG_DUMP_DB_USER=medusa
PG_DUMP_DB_NAME=medusa_mt
# DATABASE_URL=postgres://user:pass@host:5432/dbname

MEDIA_SOURCE_DIRS=/opt/upready-store/media-tenants

DB_BACKUP_LABEL=mt-db
MEDIA_BACKUP_LABEL=mt-media
DAILY_RETENTION_COUNT=7
WEEKLY_RETENTION_COUNT=4
MIN_DUMP_SIZE_BYTES=1024
MIN_MEDIA_SIZE_BYTES=1024
MAX_BACKUP_AGE_HOURS=26
MAX_SHRINK_PERCENT=50

# --- cross-copy.sh (only read when install.sh ran with --with-cross-copy) ---
CROSS_COPY_SSH_HOST=
CROSS_COPY_SSH_USER=root
CROSS_COPY_SSH_KEY=/root/.ssh/id_ed25519_cross_copy
CROSS_COPY_REMOTE_DIR=/opt/upready-store/backups/cross-copy
REMOTE_RETENTION_DAYS=14

# Optional S3-compatible off-host copy (Timeweb Cloud / Selectel), off by
# default. aws CLI credentials (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
# belong in ~/upready/.env.keys, never in this file.
S3_ENABLED=0
S3_ENDPOINT_URL=
S3_BUCKET=
S3_PREFIX=mt

# --- restore-drill.sh (only read if --install-drill-timer was used, or when
# an operator runs the drill by hand) ---
# restore-drill.sh always restores through pg-restore.sh's DIRECT mode
# (it needs --create, which pg-restore.sh's docker-exec mode does not
# support), so TEST_ADMIN_DATABASE_URL must be reachable by a plain
# postgres:// URL. mt-postgres has no published port (deploy/compose.mt.yml),
# so on the mt host this needs either a container on the same docker network
# to run the drill from, or a temporary 127.0.0.1-only published port for
# mt-postgres removed again after the drill — see RUNBOOK.md.
TEST_ADMIN_DATABASE_URL=postgres://medusa@127.0.0.1:5432/postgres
DRILL_TABLES=tenant,product,order,customer
