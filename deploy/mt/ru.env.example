# The RU instance of upready-store (t-2026-10-03-23 / t-cherk-25), on the
# RU host (Timeweb, Moscow) — NOT the Contabo mt deployment this file is
# copied from (deploy/mt/shipshift.env.example carries the same variables
# for the INTL instance; keep both in sync when a new variable is added to
# deploy/compose.mt.yml, they are the same compose file).
#
# Copy to ru.env, fill it in, keep that copy out of git, then run
# deploy/scripts/instance-check.mjs --instance ru --env ru.env BEFORE the
# first `docker compose up` — a RESEND_API_KEY or a GA4 id in here is
# exactly the mistake docs/instances/RULES.md §2 and deploy/instances/ru.json
# exist to catch. deploy/scripts/deploy-instance.sh runs that check for you
# at every deploy; this comment is for the first, by-hand fill-in.
#
#   docker compose -p mt -f deploy/compose.mt.yml --env-file deploy/mt/ru.env up -d --build

# --- ingress ------------------------------------------------------------
# The engine (Medusa API) needs its own host: cherkashino.ru itself is the shop, a tenant domain the
# ingress sync routes to the storefront. On INTL the engine is the platform domain (shipshift.dev).
ENGINE_DOMAIN=api.cherkashino.ru
PANEL_DOMAIN=panel.cherkashino.ru
STORES_DOMAIN=stores.cherkashino.ru
TENANT_BASE_DOMAINS=cherkashino.ru
# Where THIS traefik (deploy/compose.ru-host.yml, not Coolify — there is no
# Coolify on this host) watches for dynamic configuration. Must be the exact
# host path deploy/compose.ru-host.yml's RU_TRAEFIK_DYNAMIC_DIR points at, or
# a domain added in the panel never goes live (RUNBOOK-RU.md §4).
TRAEFIK_DYNAMIC_HOST_PATH=/opt/upready-store/ru-host/traefik/dynamic
INGRESS_SYNC_INTERVAL=15

# --- cors ---------------------------------------------------------------
STORE_CORS=https://stores.cherkashino.ru
ADMIN_CORS=https://api.cherkashino.ru
AUTH_CORS=https://api.cherkashino.ru,https://panel.cherkashino.ru

# --- data -----------------------------------------------------------------
# Lives on THIS host only — docs/instances/RULES.md §1 (152-FZ Art. 18(5)).
# No cross-host replication, no shared database with the Contabo/INTL stack.
DB_NAME=medusa_ru
POSTGRES_PASSWORD=
# mt-postgres memory limit (compose.mt.yml). 512M OOM-killed the nightly pg_dump twice.
MT_POSTGRES_MEMORY_LIMIT=1536M
PROFILE=sneakers
MEDIA_HOST_PATH=/opt/upready-store/media
DEFAULT_REGION=ru
STORE_NAME=Cherkashino
STORE_EMAIL=hello@cherkashino.ru
STORE_PHONE=
STORE_ADDRESS=
STOREFRONT_DEFAULT_LOCALE=ru
LOCALE_COUNTRY_MAP=ru:ru

# --- attribution in the storefront footer ------------------------------
ATTRIBUTION_ANCHOR=
ATTRIBUTION_HREF=
ATTRIBUTION_BRAND=
ATTRIBUTION_REL=
ATTRIBUTION_GROUPS=

# --- transactional e-mail (optional, t08-order-notifications) -----------
# RU instance: the self-hosted relay on THIS host, or a provider whose own
# processing stays in Russia — never a US mail API (docs/instances/RULES.md
# §2: "RU has no mail through Resend"). deploy/mt/MAIL.md's own `mail`
# service, pointed at THIS host's own hostname/PTR, is the default choice;
# there is no RESEND_API_KEY variable here on purpose — do not add one.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=
# The relay itself (the `mail` service in compose.mt.yml). Both keys are needed
# on THIS host the moment SMTP_HOST=mail: without them the relay takes the INTL
# host's own name and domain, and instance-check.mjs stops the deploy.
# MAIL_HOSTNAME is the reverse DNS (PTR) of this host's public address.
# MAIL_SENDER_DOMAINS is the domain of SMTP_FROM, the one the DKIM and SPF
# records are published for. The whole order of steps, the DNS records and the
# outbound-port check are in deploy/mt/MAIL.md, "A Second Host".
MAIL_HOSTNAME=
MAIL_SENDER_DOMAINS=

# --- Telegram to the shop owner (optional, t08-order-notifications) -----
# Allowed on RU, but must be named — including that Telegram's own operating
# entity is outside Russia — in the privacy policy, with a SEPARATE consent
# (docs/instances/RULES.md §2). That is a page-content requirement, not
# something this env file or instance-check.mjs enforces.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_SECRET=

# --- secrets ------------------------------------------------------------
JWT_SECRET=
COOKIE_SECRET=
INTEGRATION_ENCRYPTION_KEY=
REVALIDATE_SECRET=
STOREFRONT_SETTINGS_SECRET=
STOREFRONT_DEVTOOLS_PASSWORD=

# --- accounts (converged on every boot by ensure-accounts.ts) -----------
MEDUSA_ADMIN_EMAIL=admin@cherkashino.ru
MEDUSA_ADMIN_PASSWORD=
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=

# --- paywall→onboarding demo ---
DEMO_HOSTS=
DEMO_TENANT_BASE_DOMAIN=
DEMO_PANEL_URL=

# Sign in with Yandex ID for buyers (y01, docs/auth-yandex.md) — allowed on
# RU (docs/instances/RULES.md §2). Leave YANDEX_CLIENT_ID empty and nothing
# changes.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_CALLBACK_URL=
YANDEX_CALLBACK_ORIGINS=
YANDEX_SCOPE=
YANDEX_FORCE_CONFIRM=false
NEXT_PUBLIC_YANDEX_LOGIN_ENABLED=false

# --- marketplaces -------------------------------------------------------
# `off` stops the scheduler that mirrors Wildberries and Ozon every few minutes
# (apps/backend/src/jobs/marketplace-sync.ts); «Обновить сейчас» in the panel
# keeps working. Leave it unset in normal operation: it is the switch for the
# hours when a sync run itself endangers the backend.
# MP_SCHEDULER=off

# --- RU host monitor (deploy/scripts/ru-host-monitor.sh, RUNBOOK-RU.md §6) ---
# Not read by docker compose / the backend — this section is for the
# systemd timer's own env file, kept here only so every secret for this
# instance lives in one reviewed place. RUNBOOK-RU.md splits it into its
# own file on the host; do not wire these into compose.mt.yml.
MONITOR_HEALTH_URL=https://api.cherkashino.ru/health
MONITOR_TELEGRAM_BOT_TOKEN=
MONITOR_TELEGRAM_CHAT_ID=
