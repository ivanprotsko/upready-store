# The multi-tenant test deployment on shipshift.dev (Ivan, 2026-09-11).
# Copy to shipshift.env, fill the secrets, keep that copy out of git.
#
#   docker compose -p mt -f deploy/compose.mt.yml --env-file deploy/mt/shipshift.env up -d --build

# --- ingress ------------------------------------------------------------
# The engine: Medusa API + the native Admin at /app.
ENGINE_DOMAIN=shipshift.dev
# The shop owner's panel (its nginx proxies /auth and /tenants to the backend).
PANEL_DOMAIN=panel.shipshift.dev
# Two more addresses the same panel answers on, one host each, both optional (the router
# rule in compose.mt.yml falls back to PANEL_DOMAIN for an unset one). A sign-in works on
# any of them: the panel's nginx proxies /auth and /tenants itself, so the session cookie
# is first-party on whichever host the owner opened. Each host needs its own DNS record to
# this server before it is set here: traefik asks Let's Encrypt for its certificate at
# once. Letters (password reset, a new order) keep linking to PANEL_DOMAIN.
# PANEL_DOMAIN_ALT=panel-store.upready.dev
# PANEL_DOMAIN_ALT_2=panel.cherkashino.com
# The platform documentation (docs/owner-guide, t-2026-10-09-104). Comma-separated hosts
# that show the panel help from their root, each under the name and logo that
# docs/owner-guide/brands.json gives it (Upready Store for a host it does not list). The
# ingress service writes one traefik router per host and traefik asks Let's Encrypt for
# its certificate at once, so put a host here only after its DNS record points at this
# server. You add a customer with a row in brands.json, a DNS record and a host here.
# The RU host takes the same variable in its own env for a Russian customer's docs host,
# docs.cherkashino.ru there, next to the shop's other hosts in the same DNS zone.
# DOCS_DOMAINS=docs.upready.dev
# The CNAME target the panel hands a shop owner for their own domain. Not a
# shop: it redirects to ENGINE_DOMAIN.
STORES_DOMAIN=stores.shipshift.dev
# Suffixes that make `<handle>.<suffix>` a tenant's technical subdomain.
TENANT_BASE_DOMAINS=shipshift.dev
# Where coolify-proxy watches for dynamic configuration (measured on the host).
TRAEFIK_DYNAMIC_HOST_PATH=/data/coolify/proxy/dynamic
# Seconds between ingress polls. A brand-new shop is unreachable until its
# router lands in mt-tenants.yml, so this is the tail of the wizard's
# "open your shop" promise — 5 s measured, 4 psql queries a minute.
INGRESS_SYNC_INTERVAL=5

# --- cors ---------------------------------------------------------------
STORE_CORS=https://stores.shipshift.dev
ADMIN_CORS=https://shipshift.dev
AUTH_CORS=https://shipshift.dev,https://panel.shipshift.dev

# --- data ---------------------------------------------------------------
DB_NAME=medusa_mt
POSTGRES_PASSWORD=
# The profile the first boot seeds; the others are added by re-running the seed.
PROFILE=sneakers
MEDIA_HOST_PATH=/opt/upready-store/media
# Course videos and files the course import writes (docs/courses/import-getcourse.md), outside the
# image and outside the nightly media backup (deploy/backup/RUNBOOK.md, «Course Media»).
COURSE_MEDIA_HOST_PATH=/opt/upready-store/media-courses
DEFAULT_REGION=us
# Every country stays in «Смена региона» for every shop here (this host sells abroad); the RU host
# leaves it unset and narrows a shop to the countries of its locales.
SHOP_REGIONS=all
STORE_NAME=Shipshift
STORE_EMAIL=hello@shipshift.dev
# Both show up in the footer of every transactional letter. Empty renders an
# empty line rather than a placeholder, so fill them or leave them out.
STORE_PHONE=
STORE_ADDRESS=
# The language this deployment speaks. Two readers, on purpose: the storefront
# opens in it for a visitor arriving without a locale in the URL (LOCALE_PIN is
# on here, so the browser's own list does not outvote it; a pick in the language
# switcher still wins), and the backend sends a transactional email in it when
# the customer has no locale of their own (apps/backend/src/emails/i18n/locale.ts).
STOREFRONT_DEFAULT_LOCALE=ru
# Which country a locale implies, and therefore which region prices it: "ru" on
# /ru (roubles), "us" on /en (dollars). Sums come from the region's own price
# rows, nothing is converted in the markup.
LOCALE_COUNTRY_MAP=ru:ru,en:us

# --- attribution in the storefront footer ------------------------------
# «создание интернет-магазина — upready», the anchor being a link to us. Left
# empty here: the shipped defaults already say exactly that (backend
# src/api/storefront/by-host/attribution.ts). Fill one in to change the line for
# every shop this deployment serves.
ATTRIBUTION_ANCHOR=
ATTRIBUTION_HREF=
ATTRIBUTION_BRAND=
ATTRIBUTION_REL=
# Anchors handed to a GROUP of shops at once. A shop joins a group through its
# own tenant.metadata.attribution_group; a shop's own tenant.metadata.attribution
# still wins, field by field. Point 2.1 of the order: different shops carry
# different keywords, and none of it is an edit to the storefront's markup.
#   ATTRIBUTION_GROUPS={"ru-core":{"anchor":"интернет-магазин под ключ"}}
ATTRIBUTION_GROUPS=

# --- transactional e-mail (optional, t08-order-notifications) -----------
# The platform's ONE sending account: every shop's letters leave through it.
# Leave SMTP_HOST empty and the provider is not registered at all — the backend
# boots, orders complete, and every letter is logged as undeliverable instead
# (medusa-config.ts: `useSmtp = Boolean(SMTP_HOST)`).
#
# The shop's own identity does NOT live here. Its owner sets a sender name and
# a reply-to address in the panel (Настройки → Уведомления), and those are
# applied per letter; the From ADDRESS stays this account's, because a domain we
# cannot sign for is a domain SPF and DMARC reject.
#
# This deployment's own send-only relay (t-2026-10-02-mail-relay, the `mail`
# service in compose.mt.yml) is one option for this account: SMTP_HOST=mail,
# SMTP_PORT=587, SMTP_SECURE=false, SMTP_FROM=noreply@shipshift.dev, and leave
# SMTP_USER/SMTP_PASS empty — the relay takes no auth, only mail from this
# compose network. The DNS records that make its mail deliverable anywhere
# (DKIM, SPF) are in deploy/mt/MAIL.md, not here.
SMTP_HOST=
SMTP_PORT=587
# `true` only for implicit TLS on port 465. STARTTLS on 587 stays `false`.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The envelope sender. Usually the same mailbox as SMTP_USER.
SMTP_FROM=
# Where a customer's reply goes when the shop has not set its own.
SMTP_REPLY_TO=
# The relay's own name (its reverse DNS) and the domains it signs for. Leave
# both empty on this host: compose.mt.yml's defaults are this host's own. They
# exist for a second host (deploy/mt/ru.env.example, deploy/mt/MAIL.md).
MAIL_HOSTNAME=
MAIL_SENDER_DOMAINS=

# --- Telegram to the shop owner (optional, t08-order-notifications) -----
# The PLATFORM bot @upreadystore_bot sends the "new order" message; a shop does
# not bring a bot of its own (that question is still open: q-tg-tenant-token-store).
# The backend only calls sendMessage — long polling stays the bot container's
# job alone, because Telegram hands getUpdates to ONE consumer per token.
#
# The same token the bot container runs on (/opt/upready-store-bot/.env,
# TELEGRAM_UPREADY_STORE_BOT). Empty means no owner is notified, which is
# logged with the order id rather than passed over in silence.
TELEGRAM_BOT_TOKEN=
# The @name the panel builds its deep link on. Empty = upreadystore_bot.
TELEGRAM_BOT_USERNAME=
# Closed mode for the SHOP bots (apps/backend/src/shop-bot/access-gate.ts):
# a chat that has not typed the password sees only a prompt. Put the SHA-256
# hex of the password here (printf '%s' '<password>' | shasum -a 256), never
# the password itself. Empty = open mode. The owner's /start mgr_<code> link
# opens the bot without the password.
SHOP_BOT_ACCESS_PASSWORD_SHA256=
# Shared secret for POST /telegram/link, the one call the bot makes into the
# backend. The SAME value goes into the bot's own .env as TELEGRAM_LINK_SECRET.
# Empty here refuses every link attempt: an unset secret would leave that route
# open to anyone.
TELEGRAM_LINK_SECRET=

# --- secrets ------------------------------------------------------------
JWT_SECRET=
COOKIE_SECRET=
INTEGRATION_ENCRYPTION_KEY=
REVALIDATE_SECRET=
STOREFRONT_SETTINGS_SECRET=
STOREFRONT_DEVTOOLS_PASSWORD=

# --- accounts (converged on every boot by ensure-accounts.ts) -----------
MEDUSA_ADMIN_EMAIL=admin@upready.dev
MEDUSA_ADMIN_PASSWORD=
DEMO_CUSTOMER_EMAIL=user@upready.dev
DEMO_CUSTOMER_PASSWORD=

# --- paywall→onboarding demo ---
DEMO_HOSTS=
DEMO_TENANT_BASE_DOMAIN=
DEMO_PANEL_URL=

# Sign in with Yandex ID for buyers (y01, docs/auth-yandex.md). Leave
# YANDEX_CLIENT_ID empty and nothing changes. YANDEX_CALLBACK_URL is the
# primary storefront host's callback, YANDEX_CALLBACK_ORIGINS the other
# storefront origins (comma-separated); every one of them is also a Redirect
# URI in the Yandex OAuth application, character for character.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_CALLBACK_URL=
YANDEX_CALLBACK_ORIGINS=
YANDEX_SCOPE=
YANDEX_FORCE_CONFIRM=false
# Baked into the storefront image at build time (see compose.mt.yml).
NEXT_PUBLIC_YANDEX_LOGIN_ENABLED=false

# --- school cabinet (apps/school, t-2026-10-08-37) ----------------------
# No school runs on INTL: the one school reads the buyers of cherkashino.ru,
# a shop of the RU instance, and runs there (deploy/mt/ru.env.example).
# deploy/instances/intl.json names no school domain, so instance-check.mjs
# fails a SCHOOL_DOMAIN set here.
# SCHOOL_SSO_RETURN_HOSTS, the school's sign-in through the shop
# (t-2026-10-08-36), is RU only: deploy/instances/intl.json forbids it here.
