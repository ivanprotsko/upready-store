# Long Morning (home-goods) — copy to long-morning.env, fill in every blank, keep
# real values OUT of git (deploy/.gitignore, added by this package, covers
# deploy/stands/*.env). Read by deploy/compose.stand.yml as
# --env-file deploy/stands/long-morning.env.
#
# Var names match the two apps' own .env.template files
# (apps/backend/.env.template, apps/storefront/.env.template) plus the
# store-profile pair (STORE_PROFILE / STORE_MEDIA_BASE_URL, confirmed
# present on the home-goods worktree's apps/backend/.env and
# apps/storefront/.env.local, absent from the checked-in templates because
# the store-profile wave added them after the templates were last touched).

STAND=long-morning
PROFILE=home-goods
DOMAIN=long-morning.upready.dev
API_DOMAIN=api-long-morning.upready.dev
STORE_NAME=Long Morning

# docker compose -p, so five stands' containers/networks/volumes never
# collide on one host
COMPOSE_PROJECT_NAME=long-morning

# --- Secrets: generate per stand, never share across stands, never commit ---
# openssl rand -hex 32 for each
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
INTEGRATION_ENCRYPTION_KEY=
# Must match on backend and storefront for THIS stand (revalidation webhook
# and the devtools settings proxy both check it); still per-stand, not
# shared across the five (S1 §3.10 leaves "one secret for all five" open —
# treated here as "no", one value minted per stand, simplest to reason
# about and to rotate)
REVALIDATE_SECRET=
# Hidden theme-settings panel password (hold the storefront logo 2s) —
# apps/storefront/.env.template's own STOREFRONT_DEVTOOLS_PASSWORD
STOREFRONT_DEVTOOLS_PASSWORD=

# --- Minted by the backend's own seed on first boot, not chosen up front ---
# deploy/README.md orders the backend up+seeded first, then reads this key
# out of it (Store > Publishable API Keys in the Admin, or
# `medusa exec` against the seeded store) before building the storefront
# image, because build-profile.mjs and next build bake it in at build time.
MEDUSA_PUBLISHABLE_KEY=

# --- Non-secret, safe to leave as-is ---
DB_NAME=medusa_long_morning
DEFAULT_REGION=us
STOREFRONT_DEFAULT_LOCALE=en
STORE_EMAIL=hello@long-morning.upready.dev
STORE_PHONE=
STORE_ADDRESS=
GEOLOCATION_PROVIDER=ip-api
GEOLOCATION_PROVIDER_API_KEY=
GA_MEASUREMENT_ID=

# Redis/SMTP optional (medusa-config.ts:10-12 — omitted vars mean "off",
# not "broken"; the demo stands run in-memory cache/event-bus/workflow
# engine and skip email, matching AGENTS.md's own dev default)
REDIS_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=

# Host path deploy/scripts/sync-media.sh rsyncs
# apps/backend/src/migration-scripts/data/profiles/home-goods/media/ into,
# and compose.stand.yml mounts at /app/static/store-profiles/home-goods —
# read AGAIN from env by sync-media.sh, never hardcoded there either
MEDIA_HOST_PATH=/opt/stands/media

IMAGE_TAG=latest
