{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "upready.store-media-manifest/v0",
  "title": "Store profile media manifest",
  "description": "media/manifest.json of a store profile: one entry per render that reached disk, accepted, flagged for the second pass, or rejected. The bytes are re-hosted immediately after generation (rule 17d) — provider URLs never enter this file or any seed JSON. Raw renders stay forever under artifacts/media/<profile>/raw/ (paid media is never deleted). Prices per render are copied from the provider's billing, never predicted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profileId",
    "provider",
    "generatedAt",
    "entries",
    "totals"
  ],
  "properties": {
    "schema": {
      "const": "upready.store-media-manifest/v0"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,31}$"
    },
    "provider": {
      "enum": ["replicate", "fal.ai"],
      "description": "The wave of 2026-09-08 runs on fal.ai because Replicate never published a price for the model. Replicate stays as the reserve, so both are legal."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "role",
          "sha256",
          "width",
          "height",
          "bytes",
          "model",
          "predictionId",
          "prompt",
          "params",
          "referenceFiles",
          "sourceFile",
          "status",
          "createdAt"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^media/[a-z0-9][a-z0-9-]*\\.(webp|png|jpg)$",
            "description": "Delivered file relative to the profile dir (WebP, longest side 1600 px for products, 2400 px for the hero)."
          },
          "role": {
            "enum": [
              "hero",
              "angle",
              "detail",
              "lifestyle",
              "colorway",
              "banner",
              "category-tile",
              "wordmark"
            ]
          },
          "productHandle": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "categoryHandle": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "colorway": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "width": {
            "type": "integer",
            "minimum": 768
          },
          "height": {
            "type": "integer",
            "minimum": 768
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "model": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/[a-z0-9.-]+(:[a-f0-9]{64})?$",
            "description": "Replicate owner/name[:version] as run."
          },
          "predictionId": {
            "type": "string",
            "minLength": 8
          },
          "prompt": {
            "type": "string",
            "minLength": 20
          },
          "negativePrompt": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "description": "Every input sent to the model except the prompt and reference image payloads."
          },
          "referenceFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Manifest files (or raw paths) passed as reference images; empty for text-to-image."
          },
          "sourceFile": {
            "type": "string",
            "pattern": "^artifacts/media/[a-z][a-z0-9-]*/raw/.+$",
            "description": "The raw render as downloaded, untouched, gitignored, never deleted."
          },
          "costUsd": {
            "type": "number",
            "minimum": 0
          },
          "status": {
            "enum": [
              "accepted",
              "flagged",
              "rejected"
            ],
            "description": "accepted = passes the checklist; flagged = used in the catalog but queued for the second pass (pilot: no regenerations in the first run, Ivan 2026-09-07); rejected = replaced by a second-pass render."
          },
          "rejectReason": {
            "type": "string",
            "description": "Why the frame is flagged or rejected; required for both."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "flagged",
                    "rejected"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "rejectReason": {
                  "type": "string"
                }
              },
              "required": [
                "rejectReason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "colorway"
                }
              }
            },
            "then": {
              "required": [
                "colorway",
                "productHandle"
              ],
              "properties": {
                "colorway": {
                  "type": "string"
                },
                "productHandle": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "enum": [
                    "hero",
                    "angle",
                    "detail",
                    "lifestyle"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "productHandle"
              ],
              "properties": {
                "productHandle": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "category-tile"
                }
              }
            },
            "then": {
              "required": [
                "categoryHandle"
              ],
              "properties": {
                "categoryHandle": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renders",
        "accepted",
        "rejected",
        "costUsd"
      ],
      "properties": {
        "renders": {
          "type": "integer",
          "minimum": 1
        },
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "costUsd": {
          "type": "number",
          "minimum": 0
        },
        "flagged": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
