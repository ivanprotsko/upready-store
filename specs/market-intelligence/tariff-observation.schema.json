{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://upready.dev/specs/market-intelligence/tariff-observation.schema.json",
  "title": "Разбор тарифной таблицы конкурента",
  "description": "Результат чтения страницы тарифов конкурента. Потребители: сравнительная таблица (t-2026-09-13-03) и инвентарь фич. Каждое поле ведёт на снимок, из которого взято.",
  "type": "object",
  "required": ["competitor", "source", "observed_at", "plans"],
  "additionalProperties": false,
  "properties": {
    "competitor": { "type": "string", "description": "Ключ конкурента: tilda, shopify, insales, wix, …" },
    "source": {
      "type": "object",
      "required": ["url", "snapshot_id", "method"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "snapshot_id": { "type": "string" },
        "method": { "type": "string", "enum": ["selector", "agent", "manual"] },
        "request_context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "country": { "type": "string" },
            "currency": { "type": "string" },
            "locale": { "type": "string" },
            "authenticated": { "type": "boolean", "default": false }
          }
        }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "price"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "price": {
            "type": "object",
            "required": ["amount", "currency", "period"],
            "additionalProperties": false,
            "properties": {
              "amount": { "type": "number", "minimum": 0 },
              "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
              "period": { "type": "string", "enum": ["month", "year", "once", "free"] },
              "billed_as": { "type": ["string", "null"], "description": "Как подано на странице, дословно" }
            }
          },
          "price_alternatives": {
            "type": "array",
            "description": "Годовая цена, цена со скидкой и прочие варианты того же плана",
            "items": {
              "type": "object",
              "required": ["amount", "currency", "period"],
              "additionalProperties": false,
              "properties": {
                "amount": { "type": "number", "minimum": 0 },
                "currency": { "type": "string" },
                "period": { "type": "string", "enum": ["month", "year", "once", "free"] },
                "condition": { "type": ["string", "null"] }
              }
            }
          },
          "limits": {
            "type": "object",
            "description": "Числовые ограничения плана в том виде, в каком их публикует конкурент",
            "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
          },
          "features": {
            "type": "array",
            "description": "Строки набора фич дословно, без нашей интерпретации",
            "items": { "type": "string" }
          },
          "commission": {
            "type": ["object", "null"],
            "description": "Комиссия с продаж, если публикуется",
            "additionalProperties": false,
            "properties": {
              "percent": { "type": "number", "minimum": 0 },
              "condition": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "unmapped": {
      "type": "array",
      "description": "Что агент увидел на странице, но не смог разложить по схеме. Пустой массив — это утверждение, а не умолчание.",
      "items": { "type": "string" }
    }
  }
}
