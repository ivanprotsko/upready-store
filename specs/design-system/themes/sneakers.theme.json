        "--border": "#262626",
        "--input": "#262626",
        "--ring": "#d6ff3b",
        "--link": "#d6ff3b",
        "--success": "#d6ff3b",
        "--warning": "#ff990a",
        "--chart-1": "#d6ff3b",
        "--chart-2": "#a1a1a1",
        "--chart-3": "#6e6e6e",
        "--chart-4": "#454545",
        "--chart-5": "#2e2e2e",
        "--shadow-card": "inset 0 0 0 1px #ffffff14",
