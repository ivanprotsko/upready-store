{
  "schema": "upready.theme-preset/v0",
  "id": "sneakers",
  "label": "Kerbstone",
  "description": "Kerbstone, the streetwear-sneakers store profile: ink black plus exactly one acid accent (Sulphur #d6ff3b), --radius 0.25rem for hard edges. Values are section 3.1 of the profile's design/style-board.md, contrast table section 3.2. --accent is the hover surface, not the brand accent; the acid lives in --primary, --ring, --link and --success, and --primary flips polarity in light mode because Sulphur on white scores 1.15:1.",
  "dictionary": "geist-kit/theme.css",
  "source": "apps/backend/src/migration-scripts/data/profiles/sneakers/design/style-board.md section 3.1 (store-profiles pilot S2)",
  "modes": {
    "light": {
      "tokens": {
        "--radius": "0.25rem",
        "--background": "#ffffff",
        "--foreground": "#0a0a0a",
        "--card": "#ffffff",
        "--card-foreground": "#0a0a0a",
        "--popover": "#ffffff",
        "--popover-foreground": "#0a0a0a",
        "--primary": "#0a0a0a",
        "--primary-foreground": "#d6ff3b",
        "--secondary": "#f5f5f5",
        "--secondary-foreground": "#0a0a0a",
        "--muted": "#f5f5f5",
        "--muted-foreground": "#5c5c5c",
        "--accent": "#f0f0f0",
        "--accent-foreground": "#0a0a0a",
        "--destructive": "#d40000",
        "--destructive-foreground": "#ffffff",
        "--border": "#e4e4e4",
        "--input": "#e4e4e4",
        "--ring": "#4c6600",
        "--link": "#4c6600",
        "--success": "#4c6600",
        "--warning": "#b25e00",
        "--chart-1": "#4c6600",
        "--chart-2": "#5c5c5c",
        "--chart-3": "#8a8a8a",
        "--chart-4": "#b4b4b4",
        "--chart-5": "#dadada",
        "--shadow-card": "inset 0 0 0 1px #00000014, 0 2px 2px #0000000a, 0 8px 8px -8px #0000000a",
        "--shadow-float": "inset 0 0 0 1px #00000014, 0 2px 2px #0000000a, 0 8px 16px -4px #0000000a",
        "--shadow-modal": "inset 0 0 0 1px #00000014, 0 1px 1px #00000005, 0 8px 16px -4px #0000000a, 0 24px 32px -8px #0000000f"
      }
    },
    "dark": {
