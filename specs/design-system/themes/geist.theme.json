{
  "schema": "upready.theme-preset/v0",
  "id": "geist",
  "label": "Geist",
  "description": "Vendor copy of the canon palette (~/upready/packages/geist-kit/theme.css). Dark repeats the tokens geist-kit leaves to the cascade, because the preset schema requires the same key set in both modes.",
  "dictionary": "geist-kit/theme.css",
  "source": "geist-kit@b0e687b",
  "modes": {
    "light": {
      "tokens": {
        "--radius": "0.5rem",
        "--background": "#ffffff",
        "--foreground": "#171717",
        "--card": "#ffffff",
        "--card-foreground": "#171717",
        "--popover": "#ffffff",
        "--popover-foreground": "#171717",
        "--primary": "#171717",
        "--primary-foreground": "#ffffff",
        "--secondary": "#fafafa",
        "--secondary-foreground": "#171717",
        "--muted": "#f5f5f5",
        "--muted-foreground": "#666666",
        "--accent": "#f5f5f5",
        "--accent-foreground": "#171717",
        "--destructive": "#ee0000",
        "--destructive-foreground": "#ffffff",
        "--border": "#ebebeb",
        "--input": "#ebebeb",
        "--ring": "#a1a1a1",
        "--link": "#0070f3",
        "--success": "#0070f3",
        "--warning": "#f5a623",
        "--chart-1": "#0070f3",
        "--chart-2": "#50e3c2",
        "--chart-3": "#7928ca",
        "--chart-4": "#ff0080",
        "--chart-5": "#f5a623",
        "--shadow-card": "inset 0 0 0 1px #00000014, 0 2px 2px #0000000a, 0 8px 8px -8px #0000000a",
        "--shadow-float": "inset 0 0 0 1px #00000014, 0 2px 2px #0000000a, 0 8px 16px -4px #0000000a",
        "--shadow-modal": "inset 0 0 0 1px #00000014, 0 1px 1px #00000005, 0 8px 16px -4px #0000000a, 0 24px 32px -8px #0000000f"
      }
    },
    "dark": {
      "tokens": {
        "--radius": "0.5rem",
        "--background": "#0a0a0a",
        "--foreground": "#ededed",
        "--card": "#0a0a0a",
        "--card-foreground": "#ededed",
        "--popover": "#0a0a0a",
        "--popover-foreground": "#ededed",
        "--primary": "#ededed",
        "--primary-foreground": "#0a0a0a",
        "--secondary": "#1a1a1a",
        "--secondary-foreground": "#ededed",
        "--muted": "#1a1a1a",
        "--muted-foreground": "#a1a1a1",
        "--accent": "#1f1f1f",
        "--accent-foreground": "#ededed",
        "--destructive": "#ff6166",
        "--destructive-foreground": "#0a0a0a",
        "--border": "#2e2e2e",
        "--input": "#2e2e2e",
        "--ring": "#878787",
        "--link": "#52a8ff",
        "--success": "#52a8ff",
        "--warning": "#ff990a",
        "--chart-1": "#0070f3",
        "--chart-2": "#50e3c2",
        "--chart-3": "#7928ca",
        "--chart-4": "#ff0080",
        "--chart-5": "#f5a623",
        "--shadow-card": "inset 0 0 0 1px #ffffff14",
        "--shadow-float": "inset 0 0 0 1px #ffffff14",
        "--shadow-modal": "inset 0 0 0 1px #ffffff1f"
      }
    }
  }
}
