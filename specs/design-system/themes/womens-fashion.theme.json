        "--chart-5": "#17140f",
        "--shadow-card": "inset 0 0 0 1px #17140f14",
        "--shadow-float": "inset 0 0 0 1px #17140f14, 0 10px 18px -8px #17140f1f",
        "--shadow-modal": "inset 0 0 0 1px #17140f1a, 0 12px 20px -6px #17140f1f, 0 28px 44px -12px #17140f29"
