    "light": {
      "tokens": {
        "--radius": "0.125rem",
        "--background": "#f7f2e9",
        "--foreground": "#17140f",
        "--card": "#fdfaf4",
        "--card-foreground": "#17140f",
        "--popover": "#fffdf8",
        "--popover-foreground": "#17140f",
        "--primary": "#17140f",
        "--primary-foreground": "#f7f2e9",
        "--secondary": "#e9dfd0",
        "--secondary-foreground": "#332c22",
        "--muted": "#efe8db",
        "--muted-foreground": "#5c5346",
        "--accent": "#8c3b2e",
        "--accent-foreground": "#fbf7f0",
        "--destructive": "#9b2c22",
        "--destructive-foreground": "#fbf7f0",
        "--border": "#ded3c2",
        "--input": "#ded3c2",
        "--ring": "#8c3b2e",
        "--link": "#8c3b2e",
        "--success": "#3f6444",
        "--warning": "#7a5714",
        "--chart-1": "#8c3b2e",
        "--chart-2": "#3f6444",
        "--chart-3": "#7a5714",
